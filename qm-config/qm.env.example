# QM dev instance for Over the Shoulder, on Pranav's Mac.
# Copy to qm/.env (QM's `npm run dev` loads it with --env-file-if-exists=.env), fill the blanks,
# never commit it. Values verified against qm/src/config.ts and qm/docs/memory-providers.md.

NODE_ENV=development
PORT=8080
ORG_ID=northwind

# Harness: valid values are mock | pi | opencode | codex | claude (qm/src/config.ts harnessEnvStrict).
# "claude" drives the local Claude Code CLI. There is no "claude-code" value.
HARNESS=claude
# CLAUDE_BIN=/opt/homebrew/bin/claude
# CLAUDE_MODEL=claude-opus-5-5
# Model key: fill from Keychain at launch, never here:
#   ANTHROPIC_API_KEY=$(security find-generic-password -s ANTHROPIC_API_KEY -w) npm run dev
ANTHROPIC_API_KEY=

# Sandbox: run agent commands on this Mac (valid: aws local sprites smolmachines e2b modal porter agent37 superserve).
SANDBOX_BACKEND=local
HARNESS_SECURITY_POSTURE=auto
HARNESS_SHARING_POSTURE=isolated

# Postgres from qm-config/docker-compose.yml (port 5544, NOT JobPilot's). Local dev credentials only.
DATABASE_URL=postgres://ots:ots@127.0.0.1:5544/qm
SESSION_STORE=postgres

# HTTP source auth. The bot signs requests with the same value (Keychain item OTS_QM_SIGNING_SECRET).
# Generate once:  security add-generic-password -s OTS_QM_SIGNING_SECRET -a "$USER" -w "$(openssl rand -hex 32)"
# then launch QM with CORE_SIGNING_SECRET=$(security find-generic-password -s OTS_QM_SIGNING_SECRET -w).
# For a quick throwaway local run you may instead set ALLOW_UNAUTHENTICATED_CORE=1 (loopback only).
CORE_SIGNING_SECRET=
# ALLOW_UNAUTHENTICATED_CORE=1

# Procedural memory: exactly the config from qm/docs/memory-providers.md "Procedural memory (Memorable)".
MEMORY_PROVIDER_CONFIG={"providers":[{"id":"procedures","type":"memorable"}],"routes":[{"provider":"default","scopes":["personal","channel","group","team","org"],"capture":"automatic"},{"provider":"procedures","scopes":["personal"],"capture":"automatic","manage":false,"label":"Procedures"}]}
# Memorable CLI env (the provider hands only MEMORABLE_* + PATH/HOME to the CLI).
# Needs `npm i -g memorable-cli@latest` (>= 0.5.9 for the qm backend) and `memorable login`.
MEMORABLE_BACKEND=qm
MEMORABLE_DB_URL=postgres://ots:ots@127.0.0.1:5544/qm
# Recording calls the Memorable extraction service; set these from `memorable login` / Keychain at launch:
MEMORABLE_API_URL=
MEMORABLE_API_KEY=
# Consent is per scope and must be given by Pranav himself:
#   MEMORABLE_BACKEND=qm MEMORABLE_DB_URL=postgres://ots:ots@127.0.0.1:5544/qm memorable enable --scope <scope-id>

# QM's own Slack app is not needed: the Over the Shoulder bot owns Slack and calls QM over HTTP.
# Leave SLACK_BOT_TOKEN / SLACK_APP_TOKEN unset here.
