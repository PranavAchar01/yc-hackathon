{
  "name": "over-the-shoulder-bot",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "bash scripts/dev.sh",
    "start": "tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "lint": "biome check src test scripts",
    "format": "biome check --write src test scripts",
    "test": "vitest run",
    "stage": "tsx scripts/stage.ts",
    "stage:down": "tsx scripts/stage.ts down"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.128.0",
    "@slack/bolt": "^4",
    "pg": "^8.23.0",
    "zod": "^4"
  },
  "devDependencies": {
    "@biomejs/biome": "^2",
    "@types/node": "^24",
    "@types/pg": "^8.23.1",
    "tsx": "^4",
    "typescript": "^5",
    "vitest": "^3"
  }
}
